		{"id":"1ba536833cc421f5","fromNode":"bcd6b11797a64b66","fromSide":"right","toNode":"c5ce08d451657349","toSide":"left","label":"internal/domain access"},
		{"id":"5115c30ee43a2221","fromNode":"c5ce08d451657349","fromSide":"right","toNode":"9f8e2c3ec072bd0c","toSide":"left","label":"required compromise"},
		{"id":"81c27108badd8d73","fromNode":"5b4bae58736589a6","fromSide":"bottom","toNode":"66eb22d1769d4281","toSide":"top","label":"discover ports"},
		{"id":"0f6090b22262a41e","fromNode":"66eb22d1769d4281","fromSide":"right","toNode":"8189b1e4852b8409","toSide":"left","label":"port/service list"},
		{"id":"48c452c6835be064","fromNode":"7fccb85cc1458f80","fromSide":"bottom","toNode":"3be3ddeeb4836948","toSide":"top","label":"HTTP/S"},
		{"id":"68b6fbe03614651b","fromNode":"7fccb85cc1458f80","fromSide":"bottom","toNode":"097e737cfc8d0b2c","toSide":"top","label":"other services"},
		{"id":"807547e788b9aef4","fromNode":"3be3ddeeb4836948","fromSide":"bottom","toNode":"1fa0490e22261e21","toSide":"top","label":"version/feature"},
		{"id":"4948a19403b3dcfc","fromNode":"097e737cfc8d0b2c","fromSide":"bottom","toNode":"1fa0490e22261e21","toSide":"top","label":"version/config"},
		{"id":"811bdef2195dca94","fromNode":"1fa0490e22261e21","fromSide":"bottom","toNode":"c5183fa6a453e1e5","toSide":"top","label":"validate"},
