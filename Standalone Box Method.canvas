{
	"nodes":[
		{"id":"title","type":"text","text":"# OSCP Standalone Box Methodology\n\n**Enumerate → foothold → stabilize/transfer → escalate → proof**\n\nRecord credentials, usernames, ports, failed attempts, and evidence as you work.","x":-400,"y":-600,"width":800,"height":180,"color":"3"},
