		{"id":"ft-decision","type":"text","text":"## Select the source and destination","x":3440,"y":3300,"width":420,"height":100,"color":"5"},
		{"id":"ft-linux-windows","type":"text","text":"[[File Transfer/Linux → Windows|Linux → Windows Transfer Methods]]","x":3430,"y":3640,"width":440,"height":100,"color":"1"},
