		{"id":"cmdi","type":"text","text":"[[Command Injection|Command Injection]]","x":-2560,"y":960,"width":460,"height":90,"color":"4"},
		{"id":"lfi","type":"text","text":"[[LFI-Local File Inclusion|LFI — Local File Inclusion]]","x":-3640,"y":1260,"width":460,"height":90,"color":"4"},
		{"id":"linux-pe-plan","type":"text","text":"[[StandAloneBoxes/Standalone Linux Box Methodology/Linux Privilege Escalation/plan|Linux Privilege Escalation Plan]]","x":-3720,"y":1700,"width":460,"height":100,"color":"5"},
		{"id":"archive","type":"text","text":"[[Archive - ZIP Cracking|Archive / ZIP Cracking]]","x":-3640,"y":960,"width":460,"height":90,"color":"4"},
		{"id":"exif","type":"text","text":"[[Exiftool — Metadata → Usernames|ExifTool — Metadata → Usernames]]","x":-3640,"y":1110,"width":460,"height":90,"color":"4"},
		{"id":"chain-a","type":"text","text":"[[Chain A|Chain A]]","x":-2920,"y":1930,"width":350,"height":80,"color":"6"},
		{"id":"chain-b","type":"text","text":"[[Chain B|Chain B]]","x":-2490,"y":1930,"width":350,"height":80,"color":"6"},
		{"id":"chains","type":"text","text":"[[Plan-Summary-Attacks|Chained Attack Patterns — Summary]]","x":-3640,"y":1950,"width":620,"height":110,"color":"6"},
		{"id":"chain-c","type":"text","text":"[[Chain C|Chain C]]","x":-2920,"y":2060,"width":350,"height":80,"color":"6"},
		{"id":"linux-proof","type":"text","text":"## 3. Root and proof\n\nVerify identity and hostname, capture the required proof, and preserve a clean command trail for reporting.","x":-3370,"y":2680,"width":720,"height":130,"color":"5"},
		{"id":"chain-e","type":"text","text":"[[Chain E|Chain E]]","x":-2920,"y":2190,"width":350,"height":80,"color":"6"},
		{"id":"chain-g","type":"text","text":"[[Chain G|Chain G]]","x":-2920,"y":2320,"width":350,"height":80,"color":"6"},
		{"id":"chain-i","type":"text","text":"[[Chain I|Chain I]]","x":-2920,"y":2450,"width":350,"height":80,"color":"6"},
		{"id":"upload","type":"text","text":"[[File Upload Bypass|File Upload Bypass]]","x":-3100,"y":1110,"width":460,"height":90,"color":"4"},
		{"id":"git","type":"text","text":"[[git Exposed → Credential Chain|.git Exposed → Credential Chain]]","x":-2560,"y":1110,"width":460,"height":90,"color":"4"},
		{"id":"linux-foothold","type":"text","text":"## 2. Foothold obtained\n\nConfirm `whoami`, stabilize the shell, inventory credentials/configuration, and transfer tools if needed.","x":-3370,"y":1460,"width":720,"height":130,"color":"3"},
		{"id":"linux-tree","type":"text","text":"[[Decision Tree|Linux PrivEsc Decision Tree]]","x":-2400,"y":1700,"width":460,"height":100,"color":"5"},
		{"id":"udf","type":"text","text":"[[MySQL UDF RCE (root creds + FILE priv)|MySQL UDF RCE]]","x":-3100,"y":1260,"width":460,"height":90,"color":"4"},
		{"id":"ssti","type":"text","text":"[[SSTI — Server-Side Template Injection|SSTI — Server-Side Template Injection]]","x":-2560,"y":1260,"width":460,"height":90,"color":"4"},
		{"id":"linux-commands","type":"text","text":"[[Commands|Linux PrivEsc Commands]]","x":-3030,"y":1700,"width":460,"height":100,"color":"5"},
		{"id":"linux-header","type":"text","text":"# Linux path\n\nWeb enumeration is often the entry point. Turn a supported finding into execution, obtain a stable shell, then enumerate locally for root.","x":-3640,"y":540,"width":620,"height":150,"color":"4"},
		{"id":"web-hub","type":"text","text":"## 1. Web foothold techniques\n\nTest what the discovered technology and behavior support.","x":-3640,"y":770,"width":430,"height":120,"color":"4"},
		{"id":"linux-plan","type":"text","text":"[[Plan-standalone-linux|Linux Standalone Plan]]","x":-2890,"y":560,"width":360,"height":100,"color":"4"},
		{"id":"win-header","type":"text","text":"# Windows path\n\nEnumerate exposed services, gain execution, then check privileges, service/configuration weaknesses, stored credentials, and patch level.","x":-1500,"y":590,"width":650,"height":150,"color":"1"},
		{"id":"win-pe-plan","type":"text","text":"[[StandAloneBoxes/Standalone Win Box Methodology/Priviledge Escalation/Plan|Windows Privilege Escalation Plan]]","x":-1500,"y":1080,"width":520,"height":100,"color":"5"},
		{"id":"win-foothold","type":"text","text":"## Foothold obtained\n\nConfirm `whoami`, `hostname`, integrity level, groups, architecture, and available tooling before choosing a path.","x":-1230,"y":830,"width":720,"height":130,"color":"3"},
		{"id":"win-proof","type":"text","text":"## SYSTEM/Administrator and proof\n\nVerify the security context and hostname, capture the required proof, and document the successful chain.","x":-1230,"y":1550,"width":720,"height":130,"color":"5"},
		{"id":"win-creds","type":"text","text":"[[Dump Credentials (Windows Post-Exploitation)|Dump Windows Credentials]]","x":-1160,"y":1320,"width":620,"height":100,"color":"6"},
		{"id":"win-token","type":"text","text":"[[Token Priviledge|Windows Token Privileges]]","x":-820,"y":1080,"width":520,"height":100,"color":"5"},
		{"id":"win-initial","type":"text","text":"[[Initial Access|Windows Initial Access]]","x":-720,"y":610,"width":500,"height":100,"color":"1"},
		{"id":"linux-vs-windows","type":"text","text":"#### Linux vs Windows — the two worlds\n\nOSCP boxes are either Linux or Windows, and the \"god user\" is named differently on each. Everything else — the loop — stays the same.\n\n| | **Linux** | **Windows** |\n|---|---|---|\n| **Top admin user** | `root` | `SYSTEM` / Administrator |\n| **You'll often start via** | a web app on port 80 | SMB (445), RDP, or AD creds |\n| **Where passwords hide** | `/etc/shadow`, config files | SAM, LSASS memory, AD database |\n| **Privilege-escalation hunt** | sudo, SUID, cron | tokens, services, AD misconfigs |","x":-3500,"y":-40,"width":1100,"height":430,"color":"5"}
	],
